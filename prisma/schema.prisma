generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Empresa {
  id        String    @id @default(uuid())
  nombre    String    @db.VarChar(150)
  rut       String?   @db.VarChar(12)
  telefono  String?   @db.VarChar(20)
  email     String?   @db.VarChar(150)
  direccion String?   @db.VarChar(250)
  createdAt DateTime  @default(now()) @map("created_at")

  perfiles  Profile[]
  proyectos Proyecto[]

  @@map("empresas")
}

// tecnico

model Profile {
  id        String   @id @default(uuid())
  empresaId String?  @map("empresa_id")
  nombre    String   @db.VarChar(100)
  apellido  String   @db.VarChar(100)
  rut       String?  @db.VarChar(12)
  telefono  String?  @db.VarChar(20)
  email     String   @db.VarChar(150)
  rol       String   @db.VarChar(30)
  createdAt DateTime @default(now()) @map("created_at")

  empresa   Empresa?  @relation(fields: [empresaId], references: [id])
  proyectos Proyecto[]
  visitas   VisitaTecnica[]
  avances   Avance[]

  @@map("profiles")
}


model Cliente {
  id            String   @id @default(uuid())
  nombre        String   @db.VarChar(150)
  rut           String?  @db.VarChar(12)
  telefono      String   @db.VarChar(20)
  email         String?  @db.VarChar(150)
  observaciones String?  @db.Text
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  inmuebles Inmueble[]
  proyectos Proyecto[]

  @@map("clientes")
}

model Inmueble {
  id                    String   @id @default(uuid())
  clienteId             String   @map("cliente_id")
  direccion             String   @db.VarChar(250)
  comuna                String   @db.VarChar(100)
  tipoUso               String   @map("tipo_uso") @db.VarChar(50)
  materialConstruccion  String?  @map("material_construccion") @db.VarChar(100)
  superficieM2          Decimal? @map("superficie_m2") @db.Decimal(10, 2)
  antiguedadAnios       Int?     @map("antiguedad_anios")
  observaciones         String?  @db.Text
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  cliente   Cliente    @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  proyectos Proyecto[]

  @@map("inmuebles")
}

model Proyecto {
  id             String    @id @default(uuid())
  empresaId      String    @map("empresa_id")
  clienteId      String    @map("cliente_id")
  inmuebleId     String    @map("inmueble_id")
  tecnicoId      String?   @map("tecnico_id")
  titulo         String    @db.VarChar(200)
  descripcion    String?   @db.Text
  tipoTrabajo    String    @map("tipo_trabajo") @db.VarChar(50)
  estado         String    @default("solicitado") @db.VarChar(30)
  prioridad      String?   @default("media") @db.VarChar(20)
  fechaSolicitud DateTime  @map("fecha_solicitud")
  fechaVisita    DateTime? @map("fecha_visita")
  fechaInicio    DateTime? @map("fecha_inicio")
  fechaTermino   DateTime? @map("fecha_termino")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  empresa      Empresa         @relation(fields: [empresaId], references: [id])
  cliente      Cliente         @relation(fields: [clienteId], references: [id])
  inmueble     Inmueble        @relation(fields: [inmuebleId], references: [id], onDelete: Cascade)
  tecnico      Profile?        @relation(fields: [tecnicoId], references: [id])
  visitas      VisitaTecnica[]
  soluciones   Solucion[]
  cotizaciones Cotizacion[]
  avances      Avance[]

  @@map("proyectos")
}

model VisitaTecnica {
  id            String   @id @default(uuid())
  proyectoId    String   @map("proyecto_id")
  tecnicoId     String   @map("tecnico_id")
  fecha         DateTime
  motivo        String   @db.VarChar(100)
  estado        String   @default("programada") @db.VarChar(30)
  observaciones String?  @db.Text
  createdAt     DateTime @default(now()) @map("created_at")

  proyecto     Proyecto      @relation(fields: [proyectoId], references: [id], onDelete: Cascade)
  tecnico      Profile       @relation(fields: [tecnicoId], references: [id])
  levantamiento Levantamiento?

  @@map("visitas_tecnicas")
}

model Levantamiento {
  id                  String   @id @default(uuid())
  visitaId            String   @unique @map("visita_id")
  tipoInstalacion     String?  @map("tipo_instalacion") @db.VarChar(50)
  tension             String?  @db.VarChar(20)
  empalme             String?  @db.VarChar(50)
  potenciaContratada  String?  @map("potencia_contratada") @db.VarChar(50)
  puestaTierra        Boolean? @default(false) @map("puesta_tierra")
  resistenciaTierra   Decimal? @map("resistencia_tierra") @db.Decimal(10, 2)
  estadoTierra        String?  @map("estado_tierra") @db.VarChar(30)
  observaciones       String?  @db.Text
  createdAt           DateTime @default(now()) @map("created_at")

  visita    VisitaTecnica @relation(fields: [visitaId], references: [id], onDelete: Cascade)
  tableros  Tablero[]
  hallazgos Hallazgo[]

  @@map("levantamientos")
}

model Tablero {
  id               String  @id @default(uuid())
  levantamientoId  String  @map("levantamiento_id")
  nombre           String  @db.VarChar(100)
  ubicacion        String? @db.VarChar(150)
  tipo             String? @db.VarChar(50)
  marca            String? @db.VarChar(80)
  modelo           String? @db.VarChar(80)
  amperajeGeneral  String? @map("amperaje_general") @db.VarChar(20)
  estado           String? @default("por_revisar") @db.VarChar(30)
  observaciones    String? @db.Text

  levantamiento Levantamiento @relation(fields: [levantamientoId], references: [id], onDelete: Cascade)
  circuitos     Circuito[]

  @@map("tableros")
}

model Circuito {
  id                 String  @id @default(uuid())
  tableroId          String  @map("tablero_id")
  numero             String  @db.VarChar(20)
  nombre             String  @db.VarChar(100)
  tipo               String? @db.VarChar(50)
  proteccion         String? @db.VarChar(50)
  amperaje           String? @db.VarChar(20)
  seccionConductor   String? @map("seccion_conductor") @db.VarChar(20)
  estado             String? @default("por_revisar") @db.VarChar(30)
  observaciones      String? @db.Text

  tablero Tablero @relation(fields: [tableroId], references: [id], onDelete: Cascade)

  @@map("circuitos")
}

model Hallazgo {
  id                     String   @id @default(uuid())
  levantamientoId        String   @map("levantamiento_id")
  titulo                 String   @db.VarChar(150)
  descripcion            String   @db.Text
  categoria              String?  @db.VarChar(50)
  severidad              String?  @default("media") @db.VarChar(20)
  ubicacion              String?  @db.VarChar(150)
  requiereIntervencion   Boolean  @default(true) @map("requiere_intervencion")
  createdAt              DateTime @default(now()) @map("created_at")

  levantamiento Levantamiento @relation(fields: [levantamientoId], references: [id], onDelete: Cascade)
  solucion      Solucion?

  @@map("hallazgos")
}

model Solucion {
  id             String  @id @default(uuid())
  proyectoId     String  @map("proyecto_id")
  hallazgoId     String? @unique @map("hallazgo_id")
  titulo         String  @db.VarChar(150)
  descripcion    String  @db.Text
  tipo           String? @db.VarChar(50)
  prioridad      String? @default("media") @db.VarChar(20)
  estado         String? @default("propuesta") @db.VarChar(30)
  observaciones  String? @db.Text

  proyecto Proyecto  @relation(fields: [proyectoId], references: [id], onDelete: Cascade)
  hallazgo Hallazgo? @relation(fields: [hallazgoId], references: [id], onDelete: Cascade)

  @@map("soluciones")
}


model Cotizacion {
  id                    String    @id @default(uuid())
  proyectoId            String    @map("proyecto_id")
  numero                String    @unique @db.VarChar(30)
  estado                String    @default("borrador") @db.VarChar(30)
  subtotalMateriales    Decimal   @default(0) @map("subtotal_materiales") @db.Decimal(12, 2)
  subtotalManoObra      Decimal   @default(0) @map("subtotal_mano_obra") @db.Decimal(12, 2)
  utilidadPorcentaje    Decimal?  @default(0) @map("utilidad_porcentaje") @db.Decimal(5, 2)
  utilidadMonto         Decimal?  @default(0) @map("utilidad_monto") @db.Decimal(12, 2)
  total                 Decimal   @default(0) @db.Decimal(12, 2)
  validezDias           Int?      @default(15) @map("validez_dias")
  fechaEmision          DateTime  @map("fecha_emision")
  fechaVencimiento      DateTime? @map("fecha_vencimiento")
  observaciones         String?   @db.Text

  proyecto Proyecto         @relation(fields: [proyectoId], references: [id], onDelete: Cascade)
  items    CotizacionItem[]

  @@map("cotizaciones")
}

model CotizacionItem {
  id              String  @id @default(uuid())
  cotizacionId    String  @map("cotizacion_id")
  tipo            String  @db.VarChar(30) // "material" o "mano_obra"
  descripcion     String  @db.VarChar(200)
  cantidad        Decimal @db.Decimal(10, 2)
  unidad          String? @db.VarChar(20)
  precioUnitario  Decimal @map("precio_unitario") @db.Decimal(12, 2)
  subtotal        Decimal @db.Decimal(12, 2)

  cotizacion Cotizacion @relation(fields: [cotizacionId], references: [id], onDelete: Cascade)

  @@map("cotizacion_items")
}

model Avance {
  id            String   @id @default(uuid())
  proyectoId    String   @map("proyecto_id")
  tecnicoId     String   @map("tecnico_id")
  fecha         DateTime @default(now())
  descripcion   String   @db.Text
  porcentaje    Int?     @default(0)
  estado        String?  @default("en_progreso") @db.VarChar(30)

  proyecto Proyecto @relation(fields: [proyectoId], references: [id], onDelete: Cascade)
  tecnico  Profile  @relation(fields: [tecnicoId], references: [id])

  @@map("avances")
}